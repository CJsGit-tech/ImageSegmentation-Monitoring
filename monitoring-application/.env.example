# Copy to .env and fill in every required value. Docker Compose refuses to start while one is blank.

# --- Required ---
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
# Used only to create the initial Admin when that account does not exist.
# Use at least 8 characters with uppercase, lowercase, a digit and a symbol; otherwise startup logs a warning.
# Local demo values are listed in the root README (測試帳號資訊), e.g. demo_admin / Demo-Admin-2026!.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# At least 32 characters, for example the output of: openssl rand -hex 32
JWT_SECRET_KEY=

# --- Optional (defaults shown) ---
# MARIADB_DATABASE=monitoring
# MARIADB_USER=monitoring
# Login token lifetime in hours. Fractions are allowed; must be greater than 0.
# ACCESS_TOKEN_EXPIRE_HOURS=12
# DEBUG, INFO, WARNING, ERROR or CRITICAL
# LOG_LEVEL=INFO
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=1800
# How long the backend waits for the database at startup before it exits.
# DB_STARTUP_TIMEOUT_SECONDS=60
# Seconds between simulated readings of each of the 4 devices. Applied when the backend restarts.
# SIMULATOR_INTERVAL_SECONDS=30
# Days the system log is kept; older entries are removed automatically. Fractions are allowed. Applied when the backend restarts.
# LOG_RETENTION_DAYS=365
# Address and host ports for the published services. The database is never published.
# HOST_BIND_ADDRESS=127.0.0.1
# BACKEND_HOST_PORT=18000
# FRONTEND_HOST_PORT=18501
