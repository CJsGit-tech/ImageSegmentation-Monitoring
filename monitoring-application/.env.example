# Copy to .env and fill in every required value. Docker Compose refuses to start while one is blank.

# --- Required ---
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
# Test accounts, one per role. Each is created at backend startup when that account does not exist;
# once it exists, changing these values does not change it. The three usernames must differ.
# The example values below match the test accounts listed in the README. Change them for anything
# other than local testing. Use at least 8 characters with uppercase, lowercase, a digit and a symbol;
# otherwise startup logs a warning.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@12345
INITIAL_USER_USERNAME=user
INITIAL_USER_PASSWORD=User@12345
INITIAL_VIEWER_USERNAME=viewer
INITIAL_VIEWER_PASSWORD=Viewer@12345
# At least 32 characters, for example the output of: openssl rand -hex 32
JWT_SECRET_KEY=

# --- Optional (defaults shown) ---
# MARIADB_DATABASE=monitoring
# MARIADB_USER=monitoring
# Login token lifetime in hours. Fractions are allowed; must be greater than 0.
# ACCESS_TOKEN_EXPIRE_HOURS=12
# DEBUG, INFO, WARNING, ERROR or CRITICAL
# LOG_LEVEL=INFO
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=1800
# How long the backend waits for the database at startup before it exits.
# DB_STARTUP_TIMEOUT_SECONDS=60
# Seconds between simulated readings of each of the 4 devices (default: one reading per second).
# Applied when the backend restarts.
# SIMULATOR_INTERVAL_SECONDS=1
# Days the system log is kept; older entries are removed automatically. Fractions are allowed. Applied when the backend restarts.
# LOG_RETENTION_DAYS=365
# Address and host port for the frontend. The backend and database are never published.
# HOST_BIND_ADDRESS=127.0.0.1
# FRONTEND_HOST_PORT=18501
